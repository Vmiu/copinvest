# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# DeepSeek API key — used for LLM chunking (deepseek-chat)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# OpenRouter API key — used for vision parsing (qwen3-vl-32b)
# https://openrouter.ai/settings/keys
OPENROUTE_API_KEY=sk-or-...

# Voyage AI API key — used for embeddings (voyage-3, 1024 dims, multilingual)
# https://www.voyageai.com — free tier: 200M tokens/month
VOYAGE_API_KEY=pa-...

# ── Optional (defaults shown) ──────────────────────────────────────────────────

# SQLite (dev default). For production use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/copinvest
DATABASE_URL=sqlite+aiosqlite:///./copinvest.db

# Qdrant vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# JWT token lifetime in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to true to enable FastAPI debug mode
DEBUG=false
